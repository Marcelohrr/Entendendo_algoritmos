from collections import deque

def pesquisa_em_largura(grafo, letra):
    fila_de_pesquisa = deque()
    fila_de_pesquisa += grafo['A']
    verificados = set()
    while fila_de_pesquisa:
        item = fila_de_pesquisa.popleft()
        if item not in verificados:
            if item == letra:
                print(f'{letra} encontrado!')
                print(f'Verificados: {list(verificados)}.')
                return True
            fila_de_pesquisa += grafo[item]
            verificados.add(item)
    print(f'{letra} não encontrado!')
    print(f'Verificados: {list(verificados)}.')
    return False

exemplo_grafo = {
    'A': ['B', 'C', 'D'],
    'B': ['E', 'H'],
    'C': ['F'],
    'D': ['G'],
    'E': ['H'],
    'F': ['I'],
    'G': ['J'],
    'H': ['B', 'M'],
    'I': [],
    'J': [],
    'M': []
}

pesquisa_em_largura(exemplo_grafo, 'M')
