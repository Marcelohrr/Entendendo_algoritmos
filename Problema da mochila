mochila = {
    'garrafa': [15, 1],
    'estojo': [20, 3],
    'livro': [30, 4]
}

suporte_mochila = 4

# dynamic_programming[i] = [valor total máximo com peso i, lista de itens usados]
dynamic_programming = [[0, []] for _ in range(suporte_mochila + 1)]

for item, (valor, peso) in mochila.items():
    for capacidade in range(suporte_mochila, peso - 1, -1):
        if dynamic_programming[capacidade - peso][0] + valor > dynamic_programming[capacidade][0]:
            dynamic_programming[capacidade][0] = dynamic_programming[capacidade - peso][0] + valor
            dynamic_programming[capacidade][1] = dynamic_programming[capacidade - peso][1] + [item]

melhor_valor, itens_escolhidos = dynamic_programming[suporte_mochila]
print(f'Valor total: {melhor_valor}.')
print(f'Itens escolhidos: {itens_escolhidos}.')

