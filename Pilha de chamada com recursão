def call_stack_recursao(x):
    if x == 1:
        return 1
    else:
        return x * call_stack_recursao(x - 1)

exemplo_valor = 3
print(f'Fatorial de {exemplo_valor} = {call_stack_recursao(exemplo_valor)}.')

