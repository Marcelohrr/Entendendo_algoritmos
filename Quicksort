def quicksort(lista):
    if len(lista) < 2:
        return lista
    else:
        pivô = lista[0]
        sublista_menor = [x for x in lista[1:] if x <= pivô]
        sublista_maior = [x for x in lista[1:] if x > pivô]
        return quicksort(sublista_menor) + [pivô] + quicksort(sublista_maior)

exemplo_lista = [-5, 2, 0, -10, 8, 17]
print(f'Lista ordenada: {quicksort(exemplo_lista)}.')

