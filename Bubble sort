def bubble_sort(lista):
    n = len(lista)
    for i in range(n):
        verificação = True
        for j in range(0, n - i - 1): # Ao final de cada passagem i, o último valor ao fim é garantido de ser o maior entre os verificados
            if lista[j] > lista[j + 1]:
                lista[j], lista[j + 1] = lista[j + 1], lista[j]
                verificação = False
        if verificação == True:
            break
    return lista

exemplo_lista = [-5, 2, 0, -10, 8, 17]
print(f'Lista ordenada: {bubble_sort(exemplo_lista)}.')

