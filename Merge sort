def merge_sort(lista):
    if len(lista) <= 1:
        return lista
    meio = len(lista) // 2
    esquerda = merge_sort(lista[:meio]) # Slice em que o índice meio é excluído
    direita = merge_sort(lista[meio:])  # Slice em que o índice meio é incluído
    return merge(esquerda, direita)     # Só executado depois de ter retornado um único valor para esquerda e outro único para direita

def merge(e, d):
    resultado = []
    i = j = 0
    while i < len(e) and j < len(d):    # Enquanto houver algum item nas duas listas (conferindo pela posição de referência)...
        if e[i] <= d[j]:                # se o item à esquerda for menor ou igual...
            resultado.append(e[i])      # o adiciona na lista resultado;
            i += 1
        else:                           # se o item à direita for menor...
            resultado.append(d[j])      # o adiciona na lista resultado.
            j += 1
    resultado.extend(e[i:])             # Adiciona o resto de e, se sobrou algo.
    resultado.extend(d[j:])             # Adiciona o resto de d, se sobrou algo.
    return resultado

exemplo_lista = [-5, 2, 0, -10, 8, 17]
print(f'Lista ordenada: {merge_sort(exemplo_lista)}.')

